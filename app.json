{
  "expo": {
    "name": "TU CÓDIGO",
    "slug": "tu-codigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-tucodigo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.procurasiglo21.tucodigo",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.procurasiglo21.tucodigo",
      "adaptiveIcon": {
        "backgroundColor": "#15294F",
        "foregroundImage": "./assets/icon-tucodigo.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-tucodigo.png",
          "imageWidth": 160,
          "backgroundColor": "#15294F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TU CÓDIGO usa la cámara para fotografiar tu cédula y tomar tu selfie de verificación.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "tucodigo",
    "experiments": {
      "typedRoutes": true
    }
  }
}