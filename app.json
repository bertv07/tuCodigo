{
  "expo": {
    "name": "TU CÓDIGO",
    "slug": "tu-codigo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.procurasiglo21.tucodigo",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "TU CÓDIGO usa Face ID para que entres a tu cuenta de forma segura."
      }
    },
    "android": {
      "package": "com.procurasiglo21.tucodigo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#15294F"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 140,
          "backgroundColor": "#15294F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TU CÓDIGO usa la cámara para fotografiar tu cédula, tomar tu selfie de verificación y escanear códigos QR en taquilla.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TU CÓDIGO te permite elegir la foto de tu cédula desde tu galería.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TU CÓDIGO usa Face ID para que entres a tu cuenta de forma segura."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notificacion.png",
          "color": "#15294F"
        }
      ]
    ],
    "scheme": "tucodigo",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
